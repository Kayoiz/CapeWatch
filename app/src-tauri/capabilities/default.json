{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the CapeWatch page may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "mailto:*" }] },
    "autostart:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.mojang.com/*" },
        { "url": "https://sessionserver.mojang.com/*" },
        { "url": "https://textures.minecraft.net/*" }
      ]
    }
  ]
}
