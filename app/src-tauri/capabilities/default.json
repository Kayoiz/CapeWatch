{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the CapeWatch page may do",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://minecraft.wiki/*" }, { "url": "https://www.minecraft.net/*" }, { "url": "https://capes.me/*" }, { "url": "https://paypal.me/*" }, { "url": "mailto:*" }
    ] },
    "autostart:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.mojang.com/*" },
        { "url": "https://sessionserver.mojang.com/*" },
        { "url": "https://capes.me/api/*" }
      ]
    }
  ]
}
